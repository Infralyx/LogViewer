# Copy to .env and replace every CHANGE-ME value before starting V2.
# Do not put .env in source control or share it; it contains secrets.

# VictoriaLogs endpoint reachable from the Docker containers.
VICTORIALOGS_URL=http://victorialogs-host-or-ip:9428
VICTORIALOGS_TIMEOUT=30

# Browser access port for LogViewer.
LOGVIEWER_PORT=8080

# PostgreSQL. Keep this database private; Compose does not publish its port.
POSTGRES_DB=logviewer
POSTGRES_USER=logviewer_app
POSTGRES_PASSWORD=CHANGE-ME-use-a-long-random-database-password

# Local emergency/superadmin account. These credentials are read from .env only.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=CHANGE-ME-use-a-unique-long-password

# Used to sign HttpOnly session cookies. Generate a random value of at least 32 characters.
SESSION_SECRET_KEY=CHANGE-ME-generate-a-random-secret-of-at-least-32-characters
SESSION_TTL_SECONDS=1800
# Set true when LogViewer is served over HTTPS; false is for local HTTP testing only.
SESSION_COOKIE_SECURE=false

# LDAP / Active Directory. Set these to match your directory.
# Examples: ldaps://ad.example.internal:636 or ldap://ad.example.internal:389
LDAP_SERVER_URI=
LDAP_BASE_DN=DC=example,DC=internal
# Active Directory default. For OpenLDAP, this is often (uid={username}).
LDAP_USER_FILTER=(sAMAccountName={username})
# Use a read-only service account to search for a user. Leave both bind values empty
# only when using LDAP_USER_DN_TEMPLATE below.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Alternative to search bind, e.g. CN={username},OU=Users,DC=example,DC=internal
LDAP_USER_DN_TEMPLATE=
LDAP_STARTTLS=false
LDAP_ALLOW_INSECURE=false
LDAP_TLS_VALIDATE=true
# If using an internal CA, copy it to .\certs\ldap-ca.crt and set this path.
LDAP_CA_CERT_FILE=

LOG_LEVEL=INFO
